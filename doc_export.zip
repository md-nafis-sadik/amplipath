font-weight:300}.c24{font-size:14pt;font-family:"Roboto";color:#41595d;font-weight:300}.c35{font-size:12pt;font-family:"Lexend";color:#1155cc;font-weight:300}.c25{color:#303030;font-weight:300;font-size:12pt;font-family:"Roboto"}.c30{font-size:12pt;font-family:"Roboto";color:#303030;font-weight:700}.c11{text-decoration:none;vertical-align:baseline;font-style:italic}.c34{background-color:#ffffff;max-width:504pt;padding:36pt 72pt 36pt 36pt}.c7{text-decoration:none;vertical-align:baseline;font-style:normal}.c23{-webkit-text-decoration-skip:none;text-decoration:underline;text-decoration-skip-ink:none}.c8{margin-left:36pt;padding-left:0pt}.c32{vertical-align:baseline;font-style:normal}.c6{color:inherit;text-decoration:inherit}.c17{padding:0;margin:0}.c4{height:12pt}.c13{margin-right:163.5pt}.c33{font-style:italic}.title{padding-top:20pt;color:#41595d;font-weight:300;font-size:48pt;padding-bottom:10pt;font-family:"Merriweather";line-height:1.0;page-break-after:avoid;orphans:2;widows:2;text-align:center}.subtitle{padding-top:10pt;color:#41595d;font-weight:300;font-size:20pt;padding-bottom:10pt;font-family:"Lexend";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:center}li{color:#303030;font-weight:300;font-size:12pt;font-family:"Lexend"}p{margin:0;color:#303030;font-weight:300;font-size:12pt;font-family:"Lexend"}h1{padding-top:20pt;color:#41595d;font-weight:300;font-size:36pt;padding-bottom:20pt;font-family:"Merriweather";line-height:1.0;page-break-after:avoid;orphans:2;widows:2;text-align:left}h2{padding-top:20pt;color:#41595d;font-weight:300;font-size:30pt;padding-bottom:20pt;font-family:"Merriweather";line-height:1.0;page-break-after:avoid;orphans:2;widows:2;text-align:left}h3{padding-top:0pt;color:#303030;font-weight:300;font-size:14pt;padding-bottom:15pt;font-family:"Lexend";line-height:1.15;page-break-after:avoid;font-style:italic;orphans:2;widows:2;text-align:left}h4{padding-top:0pt;color:#41595d;font-weight:700;font-size:14pt;padding-bottom:10pt;font-family:"Merriweather";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}h5{padding-top:10pt;color:#41595d;font-weight:600;font-size:20pt;padding-bottom:10pt;font-family:"Lexend";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}h6{padding-top:0pt;color:#303030;font-weight:600;font-size:12pt;padding-bottom:10pt;font-family:"Lexend";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}</style></head><body class="c34 doc-content"><h4 class="c26" id="h.dtyy3rraqn7e"><span class="c36">Please take note </span><span class="c24">you are to take</span><span class="c29"><a class="c6" href="https://www.google.com/url?q=https://amberseternal.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570533635&amp;usg=AOvVaw2Ew4uGIyb98HLoz6F7pD_d">&nbsp;</a></span><span class="c28"><a class="c6" href="https://www.google.com/url?q=https://amberseternal.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570534027&amp;usg=AOvVaw3rskAtFKXXwv1RKvJ46ucL">the picture of each website attached to the job description using their website link and &nbsp;add on the card front page on the website portfolio. Also do not include the</a></span><span class="c27"><a class="c6" href="https://www.google.com/url?q=https://amberseternal.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570534086&amp;usg=AOvVaw1uoTi4Abbl2VpF6IuHTfIX">&nbsp;</a></span><span class="c28"><a class="c6" href="https://www.google.com/url?q=https://amberseternal.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570534220&amp;usg=AOvVaw2Naxwvrww--cp-VmkXm0nH">website link of any client in the work description</a></span><span class="c7 c19">.</span></h4><h1 class="c12 c13" id="h.4xd4pepveu7j"><span class="c21 c7">Amber&rsquo;s Eternal</span></h1><p class="c0"><span class="c1">Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=https://amberseternal.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570534538&amp;usg=AOvVaw3_3nFvddjw72NPVrKJRrg3">&nbsp;</a></span><span class="c35"><a class="c6" href="https://www.google.com/url?q=https://amberseternal.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570534641&amp;usg=AOvVaw1kHXIZNlKp4zwrF_cdbb0W">https://amberseternal.com/ &nbsp; </a></span></p><p class="c0"><span class="c1">Portfolio Category:</span><span class="c10">&nbsp;Websites &amp; Search<br></span><span class="c1">Industry:</span><span class="c3">&nbsp;Health, Beauty &amp; Ecommerce</span></p><h2 class="c12" id="h.1r0ducktkh06"><span class="c5">Full ecommerce development and technical SEO created a search-ready path from product discovery to checkout.</span></h2><p class="c0"><span class="c3">Amplipath designed and developed Amber&rsquo;s Eternal&rsquo;s ecommerce website from the ground up, transforming its extensive health and beauty catalogue into a structured, mobile-friendly shopping experience. We combined complete website development with technical and on-page SEO to improve product discoverability, attract relevant organic traffic and convert more visitors into customers.</span></p><h2 class="c12" id="h.ylnvef9qg8ay"><span class="c5">Key Results</span></h2><ul class="c17 lst-kix_3qwm269qxjuq-0 start"><li class="c0 c8 li-bullet-0"><span class="c1">132+</span><span class="c3">&nbsp;products supported across the live ecommerce catalogue</span></li><li class="c0 c8 li-bullet-0"><span class="c1">+</span><span class="c30">140</span><span class="c1">%</span><span class="c3">&nbsp;increase in organic website traffic</span></li><li class="c0 c8 li-bullet-0"><span class="c1">+90%</span><span class="c3">&nbsp;improvement in ecommerce conversion rate</span></li></ul><h2 class="c12" id="h.hhxpu4809w6e"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Amber&rsquo;s Eternal is a health and beauty ecommerce brand offering essential oils, skincare, haircare, cosmetics, oil diffusers and other self-care products. The brand focuses on helping customers incorporate beauty, wellness and botanical-inspired products into their everyday routines.</span></p><h2 class="c12" id="h.1h7rmfunvtuk"><span class="c5">The Opportunity</span></h2><p class="c0"><span class="c3">Amber&rsquo;s Eternal needed more than an attractive online shop. Its broad product catalogue required a clear ecommerce structure that would help customers find suitable products while giving search engines a better understanding of the brand&rsquo;s collections and individual product pages.</span></p><p class="c0"><span class="c3">The opportunity was to build a complete digital storefront that could support product discovery, organic search visibility and online sales from one connected platform.</span></p><h2 class="c12" id="h.19psd9w682u8"><span class="c5">Our Solution</span></h2><p class="c0"><span class="c3">Amplipath designed and developed the complete ecommerce website from scratch, creating the foundation for Amber&rsquo;s Eternal to present, promote and sell its products online.</span></p><p class="c0"><span class="c3">We organised the catalogue into clear shopping categories covering essential oils, skincare, haircare, cosmetics, diffusers and related beauty products. Navigation, collection pages and product pages were developed to make browsing easier across desktop and mobile devices.</span></p><p class="c0"><span class="c3">The SEO work covered the website&rsquo;s technical structure, crawlability, page hierarchy, metadata, internal linking and the optimization of important product and collection pages. This helped search engines discover and understand more of the store while improving the relevance of its pages for commercial search queries.</span></p><p class="c0"><span class="c3">We also refined the path from product discovery to checkout, ensuring that visitors could move naturally from search results and collection pages to individual products and purchasing actions.</span></p><h2 class="c12" id="h.bsr3dt7dgnxd"><span class="c5">The Results</span></h2><p class="c0"><span class="c3">The completed website gave Amber&rsquo;s Eternal a professional, scalable ecommerce presence supported by a stronger organic-search foundation.</span></p><p class="c0"><span class="c10">Following the development and SEO work, the website recorded substantial growth in search visibility, organic traffic and ecommerce conversions. More products became discoverable through search, while the improved store structure helped visitors browse relevant collections and progress more efficiently toward checkout.</span></p><h2 class="c12" id="h.7opfhqldxboh"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_5k5g7hnqxtvp-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Complete ecommerce website development</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Mobile-responsive design</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Product and collection architecture</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Ecommerce navigation and user experience</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Technical SEO</span></li><li class="c0 c8 li-bullet-0"><span class="c3">On-page SEO</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Product and collection-page optimization</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Internal linking and metadata optimization</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Conversion-focused shopping journey</span></li></ul><h2 class="c12" id="h.ip6695aj0umy"><span class="c5">Short Portfolio Card Description (The content below should be added in the front page)</span></h2><p class="c0"><span class="c3">A complete ecommerce website and SEO foundation for a growing health and beauty brand.</span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.hui83lf43q5q"><span class="c21 c7">Printin3D</span></h1><p class="c0"><span class="c1">Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=https://printin3d.co/&amp;sa=D&amp;source=editors&amp;ust=1791137570542383&amp;usg=AOvVaw0mARgx6aUnBBJSLKZT0DZL">&nbsp;</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://printin3d.co/&amp;sa=D&amp;source=editors&amp;ust=1791137570542505&amp;usg=AOvVaw2dY8oB-Mk4nJBTIof92Rlc">https://printin3d.co/<br></a></span><span class="c1">Portfolio Category:</span><span class="c10">&nbsp;Websites &amp; Search<br></span><span class="c1">Industry:</span><span class="c3">&nbsp;3D Printing &amp; Ecommerce</span></p><h2 class="c12" id="h.23uatjqy97n7"><span class="c5">Integrated Shopify, TikTok Shop and SEO launch generates 50%+ early sales growth for Printin3D.</span></h2><p class="c0"><span class="c3">Amplipath developed Printin3D&rsquo;s ecommerce operation from the ground up, creating a specialist online store for 3D printers, printing materials, parts and accessories. We combined Shopify development, dropshipping catalogue setup, technical SEO and TikTok Shop development to create a multichannel commerce system built for discovery and sales.</span></p><h2 class="c12" id="h.ahn3kc1scp3d"><span class="c5">Key Results</span></h2><ul class="c17 lst-kix_loeypqaqp6gj-0 start"><li class="c0 c8 li-bullet-0"><span class="c1">50%+</span><span class="c3">&nbsp;increase in sales within the first days after launch</span></li><li class="c0 c8 li-bullet-0"><span class="c1">3</span><span class="c3">&nbsp;ecommerce sales channels launched: Shopify, Meta shop and TikTok Shop</span></li><li class="c0 c8 li-bullet-0"><span class="c1">+400 %</span><span class="c3">&nbsp;increase in organic search traffic </span></li></ul><h2 class="c12" id="h.oukyvjjrs5ba"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Printin3D is a specialist ecommerce store offering 3D printers, printing materials and essential parts and accessories. Its catalogue serves beginners, makers, educational users and experienced customers looking for equipment and supplies for personal or professional 3D-printing projects.</span></p><p class="c0"><span class="c3">Its product range includes 3D printers, PLA, PETG, TPU and resin materials, nozzles, hotends, tools and other replacement or upgrade components.</span></p><h2 class="c12" id="h.sf4hfrtsx6ay"><span class="c5">The Opportunity</span></h2><p class="c0"><span class="c3">Launching a specialist ecommerce business in the 3D-printing market required a platform capable of organising a technically diverse catalogue without making product discovery difficult.</span></p><p class="c0"><span class="c3">Printin3D needed to attract customers through search, help buyers navigate different printers and materials, support dropship products and generate sales beyond a single website channel.</span></p><p class="c0"><span class="c3">The opportunity was to create a connected ecommerce system in which Shopify, organic search and TikTok Shop could work together to increase visibility and purchasing opportunities.</span></p><h2 class="c12" id="h.oneho6f1ntza"><span class="c5">Our Solution</span></h2><p class="c0"><span class="c3">Amplipath designed and developed the complete Shopify ecommerce store, establishing its visual structure, navigation, product catalogue, collection pages and purchasing journey.</span></p><p class="c0"><span class="c3">Products were organised into clear commercial categories, including 3D printers, printing materials, parts and accessories. This structure made it easier for customers to find relevant equipment while creating stronger category-level landing pages for search engines.</span></p><p class="c0"><span class="c3">We implemented full technical and on-page SEO across the store. This included improving the site hierarchy, crawlability, metadata, internal linking and the optimization of product and collection pages around relevant search intent.</span></p><p class="c0"><span class="c3">To extend the store beyond its website, we also developed its Meta shop (Facebook &amp; Instagram) and TikTok Shop presence, prepared products for discovery and purchase through the platform. This gave Printin3D two complementary ecommerce channels through which customers could discover and buy its products.</span></p><h2 class="c12" id="h.e98v9gz1gn2w"><span class="c5">The Results</span></h2><p class="c0"><span class="c10">The combined Shopify and TikTok Shop launch produced an immediate commercial impact. Printin3D recorded more than </span><span class="c1">50% growth in sales within the first few days of launch</span><span class="c3">, demonstrating the value of connecting a purpose-built ecommerce website with an additional social-commerce channel.</span></p><p class="c0"><span class="c10">The SEO foundation also expanded the store&rsquo;s presence across relevant product searches, helping its printer, filament, resin and accessory pages gain greater search visibility.</span></p><h2 class="c12" id="h.3knuqm42k0ex"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_nl5whbodk8zs-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Complete Shopify ecommerce development</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Dropshipping catalogue setup</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Product and collection architecture</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Mobile-responsive shopping experience</span></li><li class="c0 c8 li-bullet-0"><span class="c3">TikTok Shop and Meta Shop development</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Technical SEO</span></li><li class="c0 c8 li-bullet-0"><span class="c3">On-page and ecommerce SEO</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Product and collection-page optimization</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Search-focused site structure</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Conversion journey development</span></li></ul><h2 class="c12" id="h.ix9zf0xsljii"><span class="c5">Short Portfolio Card Description</span></h2><p class="c0"><span class="c3">A Shopify, TikTok Shop and SEO ecosystem for a specialist 3D-printing retailer&mdash;generating more than 50% early sales growth while building a stronger foundation for organic discovery.</span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.ppv4jy27ix15"><span class="c21 c7">Furry Fiesta</span></h1><p class="c0"><span class="c1">Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=https://furryfiesta.shop/&amp;sa=D&amp;source=editors&amp;ust=1791137570550492&amp;usg=AOvVaw148Hd9XhlHNQJRz1aLVPop">&nbsp;</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://furryfiesta.shop/&amp;sa=D&amp;source=editors&amp;ust=1791137570550592&amp;usg=AOvVaw0GYm_ClN4aodAw0qA9qwzW">furryfiesta.shop<br></a></span><span class="c1">Primary Category:</span><span class="c10">&nbsp;Websites &amp; Search<br></span><span class="c1">Industry:</span><span class="c10">&nbsp;Pet Ecommerce<br></span><span class="c1">Services:</span><span class="c3">&nbsp;Ecommerce Redesign, Conversion Optimisation, Mobile Responsiveness</span></p><h2 class="c12" id="h.i5drdq92cval"><span class="c5">Conversion-focused ecommerce redesign delivers a 250%+ increase in store conversions.</span></h2><p class="c0"><span class="c3">Amplipath redesigned Furry Fiesta&rsquo;s ecommerce store to create a clearer, more engaging shopping experience that made it easier for pet owners to discover products and complete their purchases.</span></p><h3 class="c14" id="h.h80v4eco3cca"><span class="c9 c11">Key Result</span></h3><p class="c0"><span class="c1">+250%<br></span><span class="c3">Increase in ecommerce conversions following the store redesign.</span></p><h2 class="c12" id="h.antpfix4cf9z"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Furry Fiesta is an online pet-accessories retailer built around the belief that pets are part of the family. The store offers products including pet beds, grooming brushes, collars, feeding bowls, toys, waste-management products and other everyday pet essentials.</span></p><p class="c0"><span class="c3">Its goal is to give pet owners convenient access to products that combine comfort, functionality, safety and style.</span></p><h2 class="c12" id="h.93rrlimwfd53"><span class="c5">The Opportunity</span></h2><h3 class="c14" id="h.ynnfh0gxg1hh"><span class="c9 c11">Furry Fiesta needed a more cohesive ecommerce experience capable of turning product interest into completed purchases.</span></h3><p class="c0"><span class="c3">The redesign brief went beyond improving the visual appearance of the store. The customer journey needed to be clearer&mdash;from entering the website and exploring product categories to reviewing individual products and proceeding towards checkout.</span></p><p class="c0"><span class="c3">Product discovery, navigation, page hierarchy and calls to action all needed to work together as one conversion-focused shopping system.</span></p><h2 class="c12" id="h.ozzwub4o35qw"><span class="c5">Our Solution</span></h2><h3 class="c14" id="h.kc6q0gphgzyf"><span class="c9 c11">We redesigned the store around how customers discover, evaluate and purchase pet products.</span></h3><p class="c0"><span class="c3">Amplipath restructured the ecommerce experience to make important products and categories easier to find. We refreshed the store&rsquo;s visual presentation, strengthened the page hierarchy and created clearer pathways between the homepage, collections, product pages and cart.</span></p><p class="c0"><span class="c3">Product information and calls to action were positioned to reduce unnecessary friction and help customers understand what to do next. We also improved the responsive experience so the store remained easy to browse and use across desktop and mobile devices.</span></p><p class="c0"><span class="c3">The final design preserved Furry Fiesta&rsquo;s friendly brand personality while giving the business a more professional and commercially focused digital storefront.</span></p><h2 class="c12" id="h.xg29zihw6a87"><span class="c5">The Results</span></h2><h3 class="c14" id="h.wru9mc443i2x"><span class="c9 c11">The redesigned customer journey helped Furry Fiesta record a 250%+ increase in ecommerce conversions.</span></h3><p class="c0"><span class="c3">Following the redesign, the store generated more completed conversion actions from its existing traffic. The result demonstrated how stronger product presentation, simpler navigation and a more focused buying journey could turn more visitors into customers.</span></p><p class="c0"><span class="c3">The project gave Furry Fiesta more than a refreshed visual identity&mdash;it created a better-performing ecommerce experience designed to support continued growth.</span></p><h2 class="c12" id="h.daaavl1dt1g2"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_sea7prujhv4n-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Complete ecommerce store redesign</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Product and collection-page optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Navigation and customer-journey restructuring</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Mobile-responsive design</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Calls-to-action optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Ecommerce conversion-rate optimisation</span></li></ul><h2 class="c12" id="h.8ykatnonsgoi"><span class="c5">Portfolio Hub Card</span></h2><p class="c0"><span class="c1 c7">Furry Fiesta</span></p><p class="c0"><span class="c1 c7">250%+ increase in ecommerce conversions</span></p><p class="c0"><span class="c3">A complete ecommerce redesign that improved product discovery, simplified the buying journey and helped turn more store visitors into customers.</span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.r6l682awbh2g"><span class="c21 c7">Olakunle &amp; Partners Ltd</span></h1><p class="c0"><span class="c1">Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=https://www.olakunleandpartnersltd.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570557265&amp;usg=AOvVaw2CmLSclF75h-bCv4IJa538">&nbsp;</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://www.olakunleandpartnersltd.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570557386&amp;usg=AOvVaw2C0_zIl6cqSlnIA2TkCCxX">olakunleandpartnersltd.com<br></a></span><span class="c1">Primary Category:</span><span class="c10">&nbsp;Websites &amp; Search<br></span><span class="c1">Industry:</span><span class="c10">&nbsp;Real Estate and Property Investment<br></span><span class="c1">Services:</span><span class="c3">&nbsp;Website Development, Property Listings, Lead Generation</span></p><h2 class="c12" id="h.nn2dn8r93jfn"><span class="c5">A conversion-ready real estate website produces an 80%+ increase in property enquiries.</span></h2><p class="c0"><span class="c3">Amplipath designed and developed a complete digital platform for Olakunle &amp; Partners Ltd, making it easier for property buyers, renters and investors to discover available opportunities and contact the company.</span></p><h2 class="c12" id="h.tdv196nm2m0n"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Olakunle &amp; Partners Ltd is a Nigerian real estate and property investment company providing property sales, rentals, management, development, facility management and investment services.</span></p><p class="c0"><span class="c3">The company helps individuals and businesses identify suitable properties, make informed investment decisions and navigate the process of buying, selling, renting or developing real estate.</span></p><h2 class="c12" id="h.ddmj8ezhtcd6"><span class="c5">The Opportunity</span></h2><h3 class="c14" id="h.kx0o7h7aknjk"><span class="c9 c11">Olakunle &amp; Partners needed a credible digital platform that could showcase properties and consistently generate enquiries.</span></h3><p class="c0"><span class="c3">The company required more than a standard corporate website. It needed a platform where potential clients could understand its services, explore available properties and quickly express interest in opportunities matching their budget, preferred location and property requirements.</span></p><p class="c0"><span class="c3">Trust was especially important. The website needed to present the company professionally while giving visitors clear and convenient ways to begin a property conversation.</span></p><h2 class="c12" id="h.arhtsmfmlgx3"><span class="c5">Our Solution</span></h2><h3 class="c14" id="h.pypsrdt18mqx"><span class="c9 c11">We developed an end-to-end property website that connected discovery directly to enquiry.</span></h3><p class="c0"><span class="c3">Amplipath planned the website architecture, designed the user interface and developed the complete responsive platform.</span></p><p class="c0"><span class="c3">We organised available properties into easy-to-understand categories, including properties for sale, properties for rent and estate developments. Individual listings were presented using clear imagery and relevant property information so visitors could review opportunities before contacting the company.</span></p><p class="c0"><span class="c3">We also implemented structured enquiry pathways that allow prospective clients to submit important details such as their budget, preferred location and property type. Contact and WhatsApp options provided additional ways for high-intent visitors to reach the business directly.</span></p><p class="c0"><span class="c3">The result was a professional real estate platform that worked as both a property catalogue and a lead-generation system.</span></p><h2 class="c12" id="h.27q6mokqffzu"><span class="c5">The Results</span></h2><h3 class="c14" id="h.u2hx2thafz73"><span class="c9 c11">The new website helped generate an 80%+ increase in property enquiries.</span></h3><p class="c0"><span class="c3">Following its launch, Olakunle &amp; Partners recorded a significant improvement in enquiries from prospective buyers, renters and property investors.</span></p><p class="c0"><span class="c3">The website established a more credible digital presence while giving the business a scalable platform for promoting new listings and generating future opportunities.</span></p><h2 class="c12" id="h.yzoj0uiqjrm5"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_cgukh2jtyksb-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Website strategy and information architecture</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Responsive website development</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Property listing and category structure</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Lead-generation form development</span></li><li class="c0 c8 li-bullet-0"><span class="c3">WhatsApp and contact-path integration</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Conversion-path optimisation</span></li></ul><h2 class="c12" id="h.owvsqrncy6vz"><span class="c5">Portfolio Hub Card</span></h2><p class="c0"><span class="c1 c7">Olakunle &amp; Partners Ltd</span></p><p class="c0"><span class="c1 c7">80%+ increase in property enquiries</span></p><p class="c0"><span class="c3">A complete real estate website that transformed property discovery into a clearer, more credible and conversion-focused enquiry experience.</span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.eau5dc1og8sq"><span class="c21 c7">Ace of Coins</span></h1><p class="c0"><span class="c1">Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=https://aceofcoins.club/&amp;sa=D&amp;source=editors&amp;ust=1791137570564282&amp;usg=AOvVaw1NNYYhBU78FkKAZyZoz7PU">&nbsp;</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://aceofcoins.club/&amp;sa=D&amp;source=editors&amp;ust=1791137570564378&amp;usg=AOvVaw3ACIe-obi4Miw9x8GJvKRc">aceofcoins.club<br></a></span><span class="c1">Primary Category:</span><span class="c10">&nbsp;Paid Ads &amp; Growth<br></span><span class="c1">Industry:</span><span class="c10">&nbsp;Online Education and Digital Courses<br></span><span class="c1">Services:</span><span class="c3">&nbsp;Sales Funnel Development, Landing Pages, Conversion Strategy, Analytics</span></p><h2 class="c12" id="h.p530ktrjrvp6"><span class="c5">Two conversion-focused course funnels generate 8,759 page views and a 35%+ conversion rate.</span></h2><p class="c0"><span class="c10">Amplipath developed dedicated sales funnels for John Jay&rsquo;s </span><span class="c2">Cryptos Are Not Taxable</span><span class="c10">&nbsp;and </span><span class="c2">Divorcing the State</span><span class="c3">&nbsp;course offers, creating focused journeys that helped visitors understand each offer and proceed towards the intended conversion action.</span></p><h3 class="c14" id="h.8btx4qwia99d"><span class="c9 c11">Key Results</span></h3><p class="c0"><span class="c1">8,759<br></span><span class="c10">Page views recorded by the </span><span class="c2">Cryptos Are Not Taxable</span><span class="c3">&nbsp;funnel.</span></p><p class="c0"><span class="c1">35%+<br></span><span class="c3">Tracked conversion rate recorded by the funnel.</span></p><p class="c0"><span class="c1">2<br></span><span class="c3">Dedicated course sales funnels developed.</span></p><h2 class="c12" id="h.9rz29i28118c"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Ace of Coins is an online learning platform offering paid specialist courses and educational resources. Its catalogue brings multiple course topics together while giving learners access to individual lessons, course summaries and enrolment options.</span></p><p class="c0 c4"><span class="c3"></span></p><h2 class="c12" id="h.148pjv1wk26h"><span class="c5">Our Solution</span></h2><h3 class="c14" id="h.1kcu1ksyt8cr"><span class="c9 c11">We created separate conversion journeys for the two course offers.</span></h3><p class="c0"><span class="c10">Amplipath developed dedicated sales funnels for </span><span class="c2">Cryptos Are Not Taxable</span><span class="c10">&nbsp;and </span><span class="c2">Divorcing the State</span><span class="c3">.</span></p><p class="c0"><span class="c3">Each funnel was structured to move visitors through a deliberate sequence&mdash;from initial awareness and course positioning to benefits, learning information, objection handling and the final call to action.</span></p><p class="c0"><span class="c3">We organised the available course material into a clearer message hierarchy, strengthened the placement of calls to action and created responsive page layouts that remained accessible across desktop and mobile devices.</span></p><p class="c0"><span class="c3">Tracking was incorporated into the funnel experience so traffic and defined conversion actions could be measured instead of relying only on general website activity.</span></p><h2 class="c12" id="h.x6eliffa4izd"><span class="c5">The Results</span></h2><h3 class="c14" id="h.l6lz7lh89vs5"><span class="c9">The </span><span class="c9 c33">Cryptos Are Not Taxable</span><span class="c9 c11">&nbsp;funnel attracted 8,759 page views and recorded a conversion rate above 35%.</span></h3><p class="c0"><span class="c3">The result showed that a focused course funnel could attract meaningful attention and move a substantial portion of visitors towards the defined conversion action.</span></p><p class="c0"><span class="c10">The second funnel gave </span><span class="c2">Divorcing the State</span><span class="c3">&nbsp;its own structured sales journey, allowing the course to be promoted independently rather than relying solely on the wider course catalogue.</span></p><p class="c0"><span class="c3">Together, the two funnels created a stronger growth foundation for promoting specialist educational offers and measuring how effectively visitors moved from interest to action.</span></p><h2 class="c12" id="h.103mpmcap9px"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_to99u5k3rndd-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Sales-funnel strategy</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Landing-page design and development</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Calls-to-action optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Responsive funnel development</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Conversion-rate optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Traffic and conversion tracking</span></li></ul><h2 class="c12" id="h.fevqnpde50no"><span class="c5">Portfolio Hub Card</span></h2><p class="c0"><span class="c1 c7">Ace of Coins</span></p><p class="c0"><span class="c1 c7">8,759 page views with a 35%+ funnel conversion rate</span></p><p class="c0"><span class="c3">Two purpose-built course funnels designed to turn specialised educational offers into focused, measurable conversion journeys.</span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.gqbkrqh6ynde"><span class="c21 c7">Forbidden Touch</span></h1><p class="c0"><span class="c1">Project Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=http://forbiddentouch.net/&amp;sa=D&amp;source=editors&amp;ust=1791137570570985&amp;usg=AOvVaw03C5OGyvIxU7stNFmXXh2R">&nbsp;</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=http://forbiddentouch.net&amp;sa=D&amp;source=editors&amp;ust=1791137570571085&amp;usg=AOvVaw1xZn5Wx1MrU58XT95hcjKG">forbiddentouch.net</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=http://forbiddentouch.net/&amp;sa=D&amp;source=editors&amp;ust=1791137570571189&amp;usg=AOvVaw0oPMrQqwH_a03axz6KpiN5">&nbsp;- see the image to use below<br></a></span><span class="c1">Primary Category:</span><span class="c10">&nbsp;Websites &amp; Search<br></span><span class="c1">Industry:</span><span class="c10">&nbsp;Beauty, Spa and Wellness<br></span><span class="c1">Services:</span><span class="c3">&nbsp;Complete SEO, Technical SEO, On-Page SEO, Website Performance Optimisation</span></p><h2 class="c12" id="h.epge8qis7d8j"><span class="c5">Complete SEO optimisation achieves a 96% performance score and an A-grade website experience.</span></h2><p class="c0"><span class="c3">Amplipath implemented a complete SEO and performance optimisation programme for Forbidden Touch, strengthening the website&rsquo;s technical foundation, search readiness and overall user experience.</span></p><h3 class="c14" id="h.e4bet2db4fa6"><span class="c9 c11">Key Results</span></h3><p class="c0"><span class="c1">96%<br></span><span class="c3">GTmetrix website performance score.</span></p><p class="c0"><span class="c1">98%<br></span><span class="c3">GTmetrix website structure score.</span></p><p class="c0"><span class="c1">1.2 seconds<br></span><span class="c3">Largest Contentful Paint.</span></p><p class="c0"><span class="c1">Grade A<br></span><span class="c3">Overall GTmetrix website grade.</span></p><h2 class="c12" id="h.okxa08ccotwd"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Forbidden Touch was a beauty, wellness and body-spa brand created to provide customers with a relaxing digital experience that reflected the comfort and quality of its services.</span></p><p class="c0"><span class="c3">The website introduced the company&rsquo;s spa positioning, helped potential customers understand its offering and provided an online destination for people searching for relaxation and personal-wellness services.</span></p><h2 class="c12" id="h.moc4xuvs2d6s"><span class="c5">The Opportunity</span></h2><h3 class="c14" id="h.uz491bghv7jk"><span class="c9 c11">Forbidden Touch needed a technically strong website that could support search visibility without compromising the customer experience.</span></h3><p class="c0"><span class="c3">For a wellness business, the website represented an important first interaction with prospective customers. Slow loading, poor structure or weak on-page signals could make it more difficult for both visitors and search engines to understand the business.</span></p><p class="c0"><span class="c3">The SEO engagement therefore needed to improve more than keywords. It required a stronger technical foundation, better page organisation and a faster browsing experience.</span></p><h2 class="c12" id="h.g9x2ge73dnib"><span class="c5">Our Solution</span></h2><h3 class="c14" id="h.ah5ejid3fhk1"><span class="c9 c11">We combined technical SEO, on-page optimisation and website-performance improvements.</span></h3><p class="c0"><span class="c3">Amplipath carried out a complete SEO review to identify issues affecting search-engine accessibility, page quality and website performance.</span></p><p class="c0"><span class="c3">We improved the website&rsquo;s on-page structure, strengthened its keyword alignment and organised important content so that search engines could better understand the relationship between the business, its services and relevant customer searches.</span></p><p class="c0"><span class="c3">Technical improvements were applied across page structure, loading behaviour and website resources. Images and other page elements were reviewed to reduce unnecessary loading pressure, while the overall website experience was optimised for faster and more stable delivery.</span></p><p class="c0"><span class="c3">The work created a stronger connection between technical performance, user experience and search visibility.</span></p><h2 class="c12" id="h.2f21isswicqf"><span class="c5">The Results</span></h2><h3 class="c14" id="h.tqwducsnqncl"><span class="c9 c11">The optimised website received an A grade, with 96% performance and 98% structure scores.</span></h3><p class="c0"><span class="c3">A GTmetrix performance assessment recorded on 13 August 2023 produced the following results:</span></p><ul class="c17 lst-kix_xvopmjvbqxv8-0 start"><li class="c0 c8 li-bullet-0"><span class="c1">GTmetrix Grade:</span><span class="c3">&nbsp;A</span></li><li class="c0 c8 li-bullet-0"><span class="c1">Performance Score:</span><span class="c3">&nbsp;96%</span></li><li class="c0 c8 li-bullet-0"><span class="c1">Structure Score:</span><span class="c3">&nbsp;98%</span></li><li class="c0 c8 li-bullet-0"><span class="c1">Largest Contentful Paint:</span><span class="c3">&nbsp;1.2 seconds</span></li><li class="c0 c8 li-bullet-0"><span class="c1">Total Blocking Time:</span><span class="c3">&nbsp;59 milliseconds</span></li><li class="c0 c8 li-bullet-0"><span class="c1">Cumulative Layout Shift:</span><span class="c3">&nbsp;0.02</span></li></ul><p class="c0"><span class="c3">The 1.2-second Largest Contentful Paint indicated that the website&rsquo;s main visible content loaded quickly. The low Total Blocking Time showed that users could interact with the page without significant processing delays, while the 0.02 layout-shift score demonstrated strong visual stability.</span></p><p class="c0"><span class="c3">Together, these results established a fast and technically efficient website experience that supported both users and search-engine performance.</span></p><h2 class="c12" id="h.nb39dqf4b12m"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_sa6c90ac0txy-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Complete website SEO</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Technical SEO audit and implementation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">On-page content optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Keyword and page-topic alignment</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Website structure optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Page-speed optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Image and website-resource optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Core Web Vitals improvement</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Mobile and desktop performance review</span></li></ul><h2 class="c12" id="h.aindx8v7n9gl"><span class="c5">Portfolio Hub Card</span></h2><p class="c0"><span class="c1 c7">Forbidden Touch</span></p><p class="c0"><span class="c1 c7">96% performance and 98% website structure scores</span></p><p class="c0"><span class="c3">A complete SEO and website-performance programme that delivered an A-grade experience, 1.2-second main-content loading and excellent visual stability.</span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 1280.00px; height: 614.00px;"><img alt="" src="data:image/png;base64," style="width: 1280.00px; height: 614.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.qv96sa6p4e5r"><span class="c7 c21">Savajay</span></h1><p class="c0"><span class="c1">Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=https://savajay.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570580147&amp;usg=AOvVaw1musKSgMcbEReJpPiQL8Ms">&nbsp;</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=http://savajay.com&amp;sa=D&amp;source=editors&amp;ust=1791137570580244&amp;usg=AOvVaw3numZ6bee1m_6zhfHsp3J1">savajay.com</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://savajay.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570580339&amp;usg=AOvVaw2JDcRWdFJ5CvTwQBANnD3p">&nbsp;- See image to use below<br></a></span><span class="c1">Primary Category:</span><span class="c10">&nbsp;Websites &amp; Search<br></span><span class="c1">Industry:</span><span class="c10">&nbsp;Cannabis Accessories and Ecommerce<br></span><span class="c1">Services:</span><span class="c3">&nbsp;Complete SEO, Technical SEO, On-Page SEO, Keyword Optimisation, Site Audit</span></p><h2 class="c12" id="h.60pse1b85xyv"><span class="c5">Complete SEO implementation achieves an excellent 96/100 website health score.</span></h2><p class="c0"><span class="c3">Amplipath completed a comprehensive SEO programme for Savajay, building a stronger technical and on-page search foundation around its specialist joint extinguisher and storage product.</span></p><h3 class="c14" id="h.8uw8ujso0gv"><span class="c9 c11">Key Results</span></h3><p class="c0"><span class="c1">96/100<br></span><span class="c3">Excellent website health score.</span></p><p class="c0"><span class="c1">127<br></span><span class="c3">URLs reported without errors.</span></p><p class="c0"><span class="c1">130<br></span><span class="c3">Successful HTTP responses recorded.</span></p><p class="c0"><span class="c1">125<br></span><span class="c3">Website URLs and resources reviewed during the audit.</span></p><h2 class="c12" id="h.ncdtzj2c7n53"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Savajay is a specialist product brand offering a compact device designed to extinguish and store partially used joints.</span></p><p class="c0"><span class="c3">The product combines a joint extinguisher, holder and smell-resistant storage solution in a portable format, allowing customers to preserve their product and carry it more conveniently.</span></p><p class="c0"><span class="c3">Because the product represents a highly specialised category, the website needed to explain its function clearly while targeting the terms prospective customers were most likely to search.</span></p><h2 class="c12" id="h.u3dalf1wih1k"><span class="c5">The Opportunity</span></h2><h3 class="c14" id="h.2sh3kfze8gae"><span class="c9 c11">Savajay needed to establish search relevance for a distinctive product that customers might describe using several different terms.</span></h3><p class="c0"><span class="c3">Potential customers could search for the product using phrases such as &ldquo;joint extinguisher,&rdquo; &ldquo;joint storage case,&rdquo; &ldquo;joint holder,&rdquo; &ldquo;cigarette extinguisher&rdquo; or &ldquo;smell-proof joint storage.&rdquo;</span></p><p class="c0"><span class="c3">The SEO strategy needed to connect these different search terms to one clear product offering. It also needed to ensure that search engines could crawl, understand and index the website without being obstructed by preventable technical issues.</span></p><h2 class="c12" id="h.c4bf847ra5pp"><span class="c5">Our Solution</span></h2><h3 class="c14" id="h.ua663y2yqoru"><span class="c9 c11">We built an SEO foundation combining keyword alignment, structured content and technical search accessibility.</span></h3><p class="c0"><span class="c3">Amplipath conducted keyword research around Savajay&rsquo;s product category and incorporated relevant search terms into the website&rsquo;s title, description, headings and supporting content.</span></p><p class="c0"><span class="c3">The homepage was organised with one primary H1 supported by seven H2 headings and six H3 headings, creating a clear information hierarchy for visitors and search engines.</span></p><p class="c0"><span class="c3">We also configured and reviewed essential technical SEO elements, including:</span></p><ul class="c17 lst-kix_xeyrk2saopf1-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Canonical URL implementation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Index and follow directives</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Robots.txt availability</span></li><li class="c0 c8 li-bullet-0"><span class="c3">XML sitemap availability</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Heading hierarchy</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Internal and external links</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Website crawlability</span></li><li class="c0 c8 li-bullet-0"><span class="c3">HTTP response status</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Page titles and meta descriptions</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Keyword-to-page relevance</span></li></ul><p class="c0"><span class="c3">The complete implementation made the site easier for search engines to interpret while maintaining a clear product-focused experience for visitors.</span></p><h2 class="c12" id="h.khfh93pbxnft"><span class="c5">The Results</span></h2><h3 class="c14" id="h.a7wx4zu9vdn3"><span class="c9 c11">The completed SEO work produced an excellent 96/100 website health score.</span></h3><p class="c0"><span class="c3">The technical site audit recorded on 11 December 2023 showed:</span></p><ul class="c17 lst-kix_1h4dqs4i138x-0 start"><li class="c0 c8 li-bullet-0"><span class="c1 c7">96/100 overall website health score</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">127 URLs reported without errors</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">130 successful 2xx HTTP responses</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">Only two redirect responses</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">125 website URLs and resources reviewed</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">Seven supporting H2 headings</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">Canonical URL correctly detected</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">Index and follow instructions detected</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">Robots.txt and XML sitemap detected</span></li></ul><p class="c0"><span class="c3">The project gave Savajay a search-ready website structure capable of communicating an unfamiliar product more clearly and supporting future organic-search growth.</span></p><h2 class="c12" id="h.bic7mtlwanmf"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_1y4ua6qcmuex-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Complete website SEO</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Technical SEO audit</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Keyword research and mapping</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Search-optimised page titles and descriptions</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Heading and content hierarchy optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Canonical URL implementation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Robots.txt and XML sitemap review</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Crawlability and indexation optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Link and HTTP status review</span></li><li class="c0 c8 li-bullet-0"><span class="c3">On-page content optimisation</span></li></ul><h2 class="c12" id="h.66ccypulgfcq"><span class="c5">Portfolio Hub Card</span></h2><p class="c0"><span class="c1 c7">Savajay</span></p><p class="c0"><span class="c1 c7">96/100 excellent website health score</span></p><p class="c0"><span class="c3">Complete technical and on-page SEO for a specialist ecommerce product, resulting in 127 error-free URLs, 130 successful HTTP responses and a search-ready website structure.</span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 1344.00px; height: 697.00px;"><img alt="" src="data:image/png;base64," style="width: 1344.00px; height: 697.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 816.00px; height: 581.00px;"><img alt="" src="data:image/png;base64," style="width: 816.00px; height: 581.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.c6nlj9h35ri1"><span class="c21 c7">Novella AI</span></h1><p class="c0"><span class="c1">Campaign:</span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://wefunder.com/novella-ai/&amp;sa=D&amp;source=editors&amp;ust=1791137570591053&amp;usg=AOvVaw0lMdofy0mdiELgGHTuetfF">Novella AI Updates, Team, and Funding Progress | Wefunder, Home of the Community Round</a></span><span class="c1">&nbsp;</span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://wefunder.com/novellaai&amp;sa=D&amp;source=editors&amp;ust=1791137570591224&amp;usg=AOvVaw1DW4p0ZFBoS7j-cjva-biv"><br></a></span><span class="c1">Primary Category:</span><span class="c10">&nbsp;</span><span class="c22">Content, Strategy &amp; Analytics</span><span class="c7 c25">&nbsp;</span></p><p class="c0"><span class="c1">Industry:</span><span class="c10">&nbsp;AI, SaaS and Video Technology<br></span><span class="c1">Services:</span><span class="c3">&nbsp;Equity Crowdfunding Marketing, Direct Investor Outreach, Social Media Marketing, Community and Forum Promotion</span></p><h2 class="c12" id="h.5ibax8fa49bc"><span class="c5">Integrated investor outreach helps Novella AI nearly triple its Wefunder raise to $349,494.</span></h2><p class="c0"><span class="c3">Delivered through Boostfunders, our specialist crowdfunding marketing brand, the promotional campaign helped Novella AI expand its investor reach, add approximately $233,000 to its raise and almost double its investor community.</span></p><h3 class="c14" id="h.z00mvnen0bi8"><span class="c9 c11">Key Results</span></h3><p class="c0"><span class="c1">$349,494<br></span><span class="c3">Total raised on Wefunder.</span></p><p class="c0"><span class="c1">$232,985<br></span><span class="c3">Additional capital secured during the engagement.</span></p><p class="c0"><span class="c1">+200%<br></span><span class="c3">Approximate growth in total funds raised.</span></p><p class="c0"><span class="c1">+95.2%<br></span><span class="c3">Growth in the number of investors.</span></p><h2 class="c12" id="h.9wf3sn5hi4ay"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Novella AI is developing an advanced video-editing application created by professionals with experience across Hollywood and the technology industry.</span></p><p class="c0"><span class="c3">Its team positioned the platform as the future of video editing, combining industry knowledge with modern technology to create a more advanced and intuitive editing experience for creators and media professionals.</span></p><p class="c0"><span class="c3">The company&rsquo;s Wefunder campaign highlighted a team with experience connected to companies including Apple, Adobe and Google, supported by professionals with decades of video-editing and entertainment-industry expertise.</span></p><h2 class="c12" id="h.39ka705iurew"><span class="c5">The Opportunity</span></h2><h3 class="c14" id="h.mm47pznj4za4"><span class="c9 c11">Novella AI had already established initial investor interest but needed to reach a broader audience to maintain fundraising momentum.</span></h3><p class="c0"><span class="c10">At the beginning of our promotional engagement, the campaign had raised </span><span class="c1">$116,509 from 83 investors</span><span class="c3">.</span></p><p class="c0"><span class="c3">This demonstrated early market interest, but reaching the next stage required expanding awareness beyond the company&rsquo;s immediate network and consistently introducing the investment opportunity to relevant audiences.</span></p><p class="c0"><span class="c3">The campaign needed a coordinated growth strategy that could increase visibility, communicate the opportunity clearly and direct prospective investors to the official Wefunder campaign page.</span></p><h2 class="c12" id="h.47etwrw1ezwj"><span class="c5">Our Solution</span></h2><h3 class="c14" id="h.hfoitbxcxl6a"><span class="c9 c11">We implemented a multichannel crowdfunding marketing strategy focused on investor discovery and campaign visibility.</span></h3><p class="c0"><span class="c3">Through Boostfunders, our team promoted Novella AI using a combination of direct investor outreach, social media marketing, forum engagement and targeted online community promotion.</span></p><p class="c0"><span class="c3">The strategy included:</span></p><ul class="c17 lst-kix_c2iw0okcyvrl-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Direct outreach to prospective investors</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Targeted presentation of the campaign opportunity</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Social media content distribution</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Relevant forum and online-community promotion</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Campaign messaging and positioning support</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Investor engagement and follow-up</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Continuous monitoring of campaign progress</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Adjustment of messaging based on audience response</span></li></ul><p class="c0"><span class="c3">Rather than relying on one promotional channel, we created multiple investor-discovery points. This allowed the campaign to reach people through direct communication, social platforms and relevant online discussions.</span></p><h2 class="c12" id="h.85b5i7rpivwp"><span class="c5">The Results</span></h2><h3 class="c14" id="h.5wfehcumqibl"><span class="c9 c11">Novella AI progressed from $116,509 raised by 83 investors to $349,494 raised by 162 investors.</span></h3><p class="c0"><span class="c3">During the engagement:</span></p><ul class="c17 lst-kix_ooj8ce4ruft-0 start"><li class="c0 c8 li-bullet-0"><span class="c10">The campaign added </span><span class="c1 c7">$232,985 in capital</span></li><li class="c0 c8 li-bullet-0"><span class="c10">Total funds raised increased by approximately </span><span class="c1 c7">200%</span></li><li class="c0 c8 li-bullet-0"><span class="c10">The campaign finished with almost </span><span class="c1 c7">three times its starting funding total</span></li><li class="c0 c8 li-bullet-0"><span class="c10">The number of investors increased from </span><span class="c1 c7">83 to 162</span></li><li class="c0 c8 li-bullet-0"><span class="c10">An additional </span><span class="c1">79 investors</span><span class="c3">&nbsp;joined the campaign</span></li><li class="c0 c8 li-bullet-0"><span class="c10">The investor community grew by approximately </span><span class="c1 c7">95.2%</span></li></ul><p class="c0"><span class="c3">The combined outreach strategy helped Novella AI maintain momentum, strengthen awareness and expand the number of people participating in its community round.</span></p><p class="c0"><span class="c3">The final result demonstrated the value of combining direct investor outreach with social media and community-led promotion instead of depending on a single acquisition channel.</span></p><h2 class="c12" id="h.7rf95nio9tca"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_nsrogfd3g4r9-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Equity crowdfunding marketing</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Direct investor outreach</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Social media marketing</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Forum and community outreach</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Campaign positioning and messaging</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Investor-engagement support</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Campaign growth monitoring</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Multichannel promotional strategy</span></li></ul><h2 class="c12" id="h.vm8llrqi8gau"><span class="c5">Portfolio Hub Card</span></h2><p class="c0"><span class="c1 c7">Novella AI</span></p><p class="c0"><span class="c1 c7">Nearly 3&times; growth in funds raised</span></p><p class="c0"><span class="c3">A multichannel investor-acquisition campaign that helped Novella AI progress from $116,509 to $349,494 and grow its investor community from 83 to 162.</span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><h1 class="c12 c13" id="h.ysd3pjl5r4ht"><span class="c21 c7">Act or Pass</span></h1><p class="c0"><span class="c1">Website:</span><span class="c10"><a class="c6" href="https://www.google.com/url?q=https://www.actorpassgame.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570602813&amp;usg=AOvVaw1mVh494gHoVH6C140vzBki">&nbsp;</a></span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://www.actorpassgame.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570602961&amp;usg=AOvVaw300K7h14f4LHNYqTH5fidg">actorpassgame.com<br></a></span><span class="c1">Primary Category:</span><span class="c10">&nbsp;Paid Ads &amp; Growth<br></span><span class="c1">Industry:</span><span class="c10">&nbsp;Games, Entertainment and Ecommerce<br></span><span class="c1">Services:</span><span class="c3">&nbsp;Community Marketing, Reddit Promotion, Classified Advertising, Social Media Marketing and YouTube Marketing</span></p><h2 class="c12" id="h.w84dxgpi1kr6"><span class="c5">Multichannel promotion drives 700% website traffic growth and more than 19,000 YouTube views.</span></h2><p class="c0"><span class="c3">Amplipath implemented a coordinated online promotion strategy for Act or Pass, combining community outreach, classified advertising, social media and YouTube marketing to increase product awareness and drive measurable website activity.</span></p><h3 class="c14" id="h.2qst9r2vzwa"><span class="c9">Key Results</span></h3><p class="c0"><span class="c1">+700%<br></span><span class="c3">Increase in website traffic.</span></p><p class="c0"><span class="c1">19,000+<br></span><span class="c3">YouTube video views generated.</span></p><p class="c0"><span class="c1">75%+<br></span><span class="c3">Reported campaign conversion rate.</span></p><h2 class="c12" id="h.z9tuqo1pqml4"><span class="c5">The Company</span></h2><p class="c0"><span class="c3">Act or Pass is a movie-inspired party card game designed to bring friends, families and colleagues together through acting, film knowledge and creative communication.</span></p><p class="c0"><span class="c3">Players divide into teams and attempt to make their teammates identify movie titles within a limited period. They can act out scenes, use movie lines, mention actors, hum theme music or describe the plot&mdash;without saying the movie title itself.</span></p><h2 class="c12" id="h.j46evhum3a7w"><span class="c5">The Opportunity</span></h2><h3 class="c14" id="h.unzxtb7wmf3w"><span class="c9 c11">Act or Pass needed to introduce an unfamiliar entertainment product to a wider audience and demonstrate the experience behind the game.</span></h3><p class="c0"><span class="c3">As a physical card game sold online, Act or Pass needed more than general brand awareness. Prospective customers had to understand how the game worked, why it was entertaining and what made it different from other party games.</span></p><p class="c0"><span class="c3">The growth strategy therefore needed to combine visual demonstrations with community conversations and direct pathways to the ecommerce website.</span></p><p class="c0"><span class="c3">The objective was to increase product discovery, generate relevant website traffic and convert interest into measurable customer actions.</span></p><h2 class="c12" id="h.jj10qb2dx0u5"><span class="c5">Our Solution</span></h2><h3 class="c14" id="h.9vy25tgki4qp"><span class="c9 c11">We created a multichannel promotional system that allowed audiences to discover the game in different digital environments.</span></h3><p class="c0"><span class="c3">Amplipath promoted Act or Pass through a combination of forum outreach, Reddit marketing, classified advertising, social media promotion and YouTube content distribution.</span></p><h3 class="c14" id="h.daqafie80a6p"><span class="c9 c11">Community and Reddit Marketing</span></h3><p class="c0"><span class="c3">We introduced the game within relevant conversations and interest-based communities where people discussed movies, entertainment, games, social activities and group experiences.</span></p><p class="c0"><span class="c3">The messaging focused on how the game worked and the experience it could create rather than relying only on direct product advertising.</span></p><h3 class="c14" id="h.ckr6z2ddao3d"><span class="c9 c11">Classified Advertising</span></h3><p class="c0"><span class="c3">We used online classified platforms to increase the product&rsquo;s discoverability and create additional routes through which prospective customers could reach the website.</span></p><h3 class="c14" id="h.lb7ueisy9ed"><span class="c9 c11">Social Media Marketing</span></h3><p class="c0"><span class="c3">Social content was used to showcase the personality of the game, explain its entertainment value and encourage users to visit the online store.</span></p><h3 class="c14" id="h.difrych5oea6"><span class="c9 c11">YouTube Marketing</span></h3><p class="c0"><span class="c3">Video provided an effective way to demonstrate the product. We promoted YouTube content that allowed prospective customers to see the concept in action and understand how Act or Pass could be played with friends, family or colleagues.</span></p><p class="c0"><span class="c3">The channels worked together as one promotional system: community exposure created awareness, video helped explain the experience and website traffic created opportunities for conversion.</span></p><h2 class="c12" id="h.hcxpuakjhz87"><span class="c5">The Results</span></h2><h3 class="c14" id="h.izpcyxk9amf2"><span class="c9 c11">The campaign produced strong improvements across awareness, traffic, video reach and conversion.</span></h3><p class="c0"><span class="c3">The promotional strategy generated:</span></p><ul class="c17 lst-kix_s53t839ws1j8-0 start"><li class="c0 c8 li-bullet-0"><span class="c1 c7">24,845 campaign impressions</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">700% increase in website traffic</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">More than 19,000 YouTube video views</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">Over 75% reported conversion rate</span></li></ul><p class="c0"><span class="c3">The 19,000+ video views demonstrated that YouTube was particularly effective in presenting the interactive nature of the product. Meanwhile, the 700% increase in website traffic showed that the combined channels successfully moved audiences from external platforms to the Act or Pass store.</span></p><p class="c0"><span class="c3">The reported conversion performance indicated that the campaign reached an audience with strong interest in the product and provided an effective pathway from awareness to the defined conversion action.</span></p><h2 class="c12" id="h.92vnsbaqhu0o"><span class="c5">Services Delivered</span></h2><ul class="c17 lst-kix_6h2ja5647pt5-0 start"><li class="c0 c8 li-bullet-0"><span class="c3">Digital growth strategy</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Reddit and forum marketing</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Online community outreach</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Classified advertising</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Social media marketing</span></li><li class="c0 c8 li-bullet-0"><span class="c3">YouTube video marketing</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Audience targeting</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Conversion-path optimisation</span></li><li class="c0 c8 li-bullet-0"><span class="c3">Campaign performance monitoring</span></li></ul><h2 class="c12" id="h.xav06er58ekx"><span class="c5">Portfolio Hub Card</span></h2><p class="c0"><span class="c1 c7">Act or Pass</span></p><p class="c0"><span class="c1 c7">700% website traffic growth and 19K+ YouTube views</span></p><p class="c0"><span class="c3">A multichannel promotional campaign combining Reddit, forums, classified advertising, social media and YouTube to generate 24,845 impressions and a reported conversion rate above 75%.</span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0 c4"><span class="c3"></span></p><p class="c0"><span class="c1">Portfolio Category:</span><span class="c3">&nbsp;Paid Ads &amp; Growth</span></p><p class="c0"><span class="c1">Course:</span><span class="c10">&nbsp;Video Editing in DaVinci Resolve 18/17: Beginner to Advanced - </span><span class="c16"><a class="c6" href="https://www.google.com/url?q=https://www.udemy.com/course/davinci-resolve-training-course/?couponCode%3DKEEPLEARNING&amp;sa=D&amp;source=editors&amp;ust=1791137570613925&amp;usg=AOvVaw1104Lx_7cc8Jbg7XeH-y92">DaVinci Resolve Mastery: The Complete Video Editing Bootcamp</a></span><span class="c3">&nbsp;(Take screenshot from the link to use as card image and you will also add the second image below on read more page)<br></span></p><p class="c0"><span class="c1">Headline:</span><span class="c3">&nbsp;Targeted course promotion delivers +9,009% student growth and +21,084% more ratings.</span></p><p class="c0"><span class="c1">Overview<br></span><span class="c3">This comprehensive DaVinci Resolve course teaches video editing, colour correction, colour grading and visual effects. At the beginning of our engagement, the course had 564 students and 45 ratings.</span></p><p class="c0"><span class="c1">Our Solution<br></span><span class="c3">We implemented a focused course-growth campaign designed to expand visibility, reach relevant learners and strengthen the course&rsquo;s marketplace credibility.</span></p><p class="c0"><span class="c1 c7">Campaign-Period Results</span></p><ul class="c17 lst-kix_nkrh77chwib7-0 start"><li class="c0 c8 li-bullet-0"><span class="c10">Student enrolment increased from </span><span class="c1">564 to 51,373</span><span class="c10">&nbsp;&mdash; a </span><span class="c1 c7">+9,009% increase</span></li><li class="c0 c8 li-bullet-0"><span class="c10">Rating volume grew from </span><span class="c1">45 to 9,533</span><span class="c10">&nbsp;&mdash; a </span><span class="c1 c7">+21,084% increase</span></li><li class="c0 c8 li-bullet-0"><span class="c10">The course retained its strong </span><span class="c1 c7">4.6-star rating</span></li></ul><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 1080.00px; height: 1080.00px;"><img alt="" src="data:image/png;base64," style="width: 1080.00px; height: 1080.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0"><span class="c1 c7">Portfolio Category: Paid Ads &amp; Growth</span></p><p class="c0"><span class="c1">Course: Pitch Yourself! Learn to Ignite Curiosity + Inspire Action<br>Client: Alexa Fischer - </span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://www.udemy.com/course/market-your-message-ignite-curiosity-inspire-action/?couponCode%3DKEEPLEARNING&amp;sa=D&amp;source=editors&amp;ust=1791137570616452&amp;usg=AOvVaw0l8p8vhwA7-SSO2slmAQ8p">Pitch Yourself! Learn to Ignite Curiosity + Inspire Action</a></span><span class="c1 c7">&nbsp;(Take card image here and add the second on job description too)</span></p><p class="c0"><span class="c1 c7">Headline: Growth campaign generates +4,317% student growth and +11,087% more ratings.</span></p><p class="c0"><span class="c1 c7">Overview<br>Pitch Yourself! is a personal-development course that helps professionals communicate their work with clarity, confidence and authenticity. Before our campaign, the course had 834 students and 92 ratings.</span></p><p class="c0"><span class="c1 c7">Our Solution<br> Targeted promotional campaign focused on increasing course discovery, attracting relevant learners and building stronger social proof.</span></p><p class="c0"><span class="c1 c7">Campaign-Period Results</span></p><ul class="c17 lst-kix_vfq6hf18t1wu-0 start"><li class="c0 c8 li-bullet-0"><span class="c1 c7">Student enrolment increased from 834 to 36,834 &mdash; a +4,317% increase</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">Rating volume grew from 92 to 10,292 &mdash; a +11,087% increase</span></li><li class="c0 c8 li-bullet-0"><span class="c1 c7">The course maintained its positive 4.5-star rating</span></li></ul><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 1080.00px; height: 1080.00px;"><img alt="" src="data:image/png;base64," style="width: 1080.00px; height: 1080.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><h2 class="c12" id="h.4rorwykxx533"><span class="c5">Thimin &mdash; AI Life Coach</span></h2><p class="c0"><span class="c1 c7">Category: AI Automation &amp; App Development<br>Industry: AI, Wellness and Personal Development<br>Platforms: iOS and Android</span></p><p class="c0"><span class="c1 c7">Portfolio card:(Use image)<br>An AI-powered life coach built to support personal growth through natural voice conversations.</span></p><p class="c0"><span class="c1 c7">Solution:<br>Thimin is a cross-platform AI life-coaching app for iOS and Android. The app combines voice-based AI conversations, contextual responses, conversation transcription, session summaries, personal journaling and goal tracking within one accessible mobile experience.</span></p><p class="c0"><span class="c1">View the App:<br></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://apps.apple.com/pk/app/thimin-ai-life-coach/id6747063345&amp;sa=D&amp;source=editors&amp;ust=1791137570619231&amp;usg=AOvVaw1DTeadaV0PxcJ-NuBPrqI2">iOS</a></span><span class="c1">&nbsp;|</span><span class="c1"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.app.thimin.prod&amp;sa=D&amp;source=editors&amp;ust=1791137570619352&amp;usg=AOvVaw356rTtEao3cN-ag3mNQ45j">&nbsp;</a></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.app.thimin.prod&amp;sa=D&amp;source=editors&amp;ust=1791137570619457&amp;usg=AOvVaw27lI9Q0nfKSWPs843WbxlW">Android</a></span><span class="c15">&nbsp;</span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 806.00px; height: 1440.00px;"><img alt="" src="data:image/png;base64," style="width: 806.00px; height: 1440.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c15"></span></p><p class="c0 c4"><span class="c15"></span></p><p class="c0 c4"><span class="c15"></span></p><h2 class="c12" id="h.39qdemsp4m6v"><span class="c5">Peony Bloom &mdash; Couples Game</span></h2><p class="c0"><span class="c1 c7">Category: AI Automation &amp; App Development<br>Industry: Lifestyle, Relationships and Mobile Gaming<br>Platforms: iOS and Android</span></p><p class="c0"><span class="c1 c7">Portfolio card:(Use image)<br>A private couples game designed to create more meaningful and playful conversations.</span></p><p class="c0"><span class="c1 c7">Solution:<br>Peony Bloom is a cross-platform couples game where partners connect privately, answer questions separately and reveal their responses together. The app includes partner invitations, multiple conversation modes, question categories, saved moments, turn notifications and premium subscription access.</span></p><p class="c0"><span class="c1">View the App:</span><span class="c1 c23"><br></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://apps.apple.com/us/app/peony-bloom/id6779698559&amp;sa=D&amp;source=editors&amp;ust=1791137570620945&amp;usg=AOvVaw2zQqdmcAHMrkqntud74uFI">iOS</a></span><span class="c1 c23">&nbsp;|</span><span class="c1 c23"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dapp.peony.mobile&amp;sa=D&amp;source=editors&amp;ust=1791137570621099&amp;usg=AOvVaw0wQJEq3gOO7MsIcWZifAaj">&nbsp;</a></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dapp.peony.mobile&amp;sa=D&amp;source=editors&amp;ust=1791137570621257&amp;usg=AOvVaw3npiHY2gExTgVd32NW-0sB">Android</a></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 230.00px; height: 498.00px;"><img alt="" src="data:image/png;base64," style="width: 230.00px; height: 498.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><h2 class="c12" id="h.laqbl3xri73b"><span class="c5">Fresenius Kabi Enteral App</span></h2><p class="c0"><span class="c1 c7">Category: AI Automation &amp; App Development<br>Industry: Healthcare and Medical Technology<br>Platforms: iOS and Android</span></p><p class="c0"><span class="c1 c7">Portfolio card: (Use image)<br>A mobile product and nutritional-reference platform built for healthcare professionals.</span></p><p class="c0"><span class="c1 c7">Solution:<br>We delivered the iOS and Android application experience for accessing Fresenius Kabi&rsquo;s adult and paediatric enteral nutrition product information. The app includes a product compendium, healthcare-professional registration, an RNI comparison tool, clinical resources, patient sample requests and PDF export functionality.</span></p><p class="c0"><span class="c1">View the App:<br></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://apps.apple.com/pk/app/fresenius-kabi-enteral-app/id1560312344&amp;sa=D&amp;source=editors&amp;ust=1791137570623116&amp;usg=AOvVaw2coLc0Og51Vwxs9B_CdlQ8">iOS</a></span><span class="c1">&nbsp;|</span><span class="c1"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.fresenius.product&amp;sa=D&amp;source=editors&amp;ust=1791137570623275&amp;usg=AOvVaw2aTWoj4qdE--vaw9nbhf3W">&nbsp;</a></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.fresenius.product&amp;sa=D&amp;source=editors&amp;ust=1791137570623421&amp;usg=AOvVaw09cOvjWfxZO6G3IhSwFIOA">Android</a></span></p><p class="c0 c4"><span class="c15"></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 230.00px; height: 498.00px;"><img alt="" src="data:image/png;base64," style="width: 230.00px; height: 498.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><h2 class="c12" id="h.x7s4pqtmg978"><span class="c5">Zarea &mdash; B2B Marketplace Mobile App</span></h2><p class="c0"><span class="c1 c7">Category: AI Automation &amp; App Development<br>Industry: B2B Ecommerce, Commodities and Procurement<br>Platforms: iOS and Android</span></p><p class="c0"><span class="c1 c7">Portfolio Card:<br>A cross-platform B2B marketplace simplifying commodity sourcing and procurement.</span></p><p class="c0"><span class="c1 c7">Solution:<br>Zarea is a cross-platform B2B marketplace that enables businesses to source construction materials, agricultural products, industrial chemicals and other commodities across Pakistan. The mobile solution includes product discovery, supplier access, streamlined checkout, order placement, delivery tracking and procurement management through a consistent iOS and Android experience.</span></p><p class="c0"><span class="c1">View the App:<br></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://apps.apple.com/pk/app/zarea-b2b-marketplace-app/id6744599845&amp;sa=D&amp;source=editors&amp;ust=1791137570625229&amp;usg=AOvVaw1nW67Ciqdi_Djo5MeWRDNz">iOS</a></span><span class="c1">&nbsp;|</span><span class="c1"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.ZareaV2&amp;sa=D&amp;source=editors&amp;ust=1791137570625350&amp;usg=AOvVaw3Pu2xxS3xPKIhn4zoLxneD">&nbsp;</a></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.ZareaV2&amp;sa=D&amp;source=editors&amp;ust=1791137570625461&amp;usg=AOvVaw2tQqOXxRFRBczIEWbnxI2A">Android</a></span></p><p class="c0 c4"><span class="c15"></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 166.00px; height: 296.00px;"><img alt="" src="data:image/png;base64," style="width: 166.00px; height: 296.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c15"></span></p><p class="c0 c4"><span class="c15"></span></p><h2 class="c12" id="h.5kh95a2fwwy4"><span class="c5">Zarea &mdash; B2B Commodity Marketplace Website</span></h2><p class="c0"><span class="c1 c7">Category: Websites &amp; Search<br>Industry: B2B Ecommerce, Commodities and Procurement<br></span></p><p class="c0"><span class="c1 c7">Portfolio Card:<br>A digital marketplace connecting commodity buyers and suppliers across Pakistan.</span></p><p class="c0"><span class="c1 c7">Solution:<br>Zarea.com is a B2B ecommerce marketplace designed to make commodity sourcing faster and more accessible. The website combines product categories, supplier access, quotation requests, customer accounts, shopping-cart functionality and corporate information within a responsive digital platform built for business procurement.</span></p><p class="c0"><span class="c1">View the Website:<br></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://zarea.com/&amp;sa=D&amp;source=editors&amp;ust=1791137570627130&amp;usg=AOvVaw1XR009G_lqgeGIp_0T9Cnd">Visit </a></span><span class="c18"><a class="c6" href="https://www.google.com/url?q=http://zarea.com&amp;sa=D&amp;source=editors&amp;ust=1791137570627252&amp;usg=AOvVaw1I-qq_Bt8dIiPtV-Ft7YXb">Zarea.com</a></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 1338.00px; height: 952.00px;"><img alt="" src="data:image/png;base64," style="width: 1338.00px; height: 952.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><h2 class="c12" id="h.cakpd75vh6x6"><span class="c5">Post Padel &ndash; AI Coaching Mobile App</span></h2><p class="c0"><span class="c1 c7">Category: AI Automation &amp; App Development<br>Industry: Sports Technology<br>Platforms: iOS and Android<br>Services: Mobile App Development, AI Integration and App-Store Deployment</span></p><h3 class="c14" id="h.lxjmf33j4fmc"><span class="c9 c11">Portfolio Card Summary</span></h3><p class="c0"><span class="c1 c7">An AI-powered padel coaching app that transforms match data into personalized improvement tips, performance insights and shareable coaching reports.</span></p><h3 class="c14" id="h.7b9xrdrzpnhd"><span class="c9 c11">App Overview</span></h3><p class="c0"><span class="c1 c7">Post Padel helps padel players learn from every match or training session. Players can record their performance, assess individual shots and monitor how their game develops over time.</span></p><h3 class="c14" id="h.vceck9h55g1h"><span class="c9 c11">Solution</span></h3><p class="c0"><span class="c1 c7">Post Padel is an AI-powered mobile coaching application built for iOS and Android. The app converts each player&rsquo;s logged match data into personalized coaching tips, weekly and monthly progress insights and exportable reports that can be shared with a trainer.</span></p><p class="c0"><span class="c1 c7">The solution also supports panel-specific performance tracking across serves, volleys, smashes, forehands, backhands, bandejas, viboras and other important areas of the game.</span></p><h3 class="c14" id="h.feipzqped9bu"><span class="c9 c11">App Links</span></h3><p class="c0"><span class="c20"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.app.postpadel&amp;sa=D&amp;source=editors&amp;ust=1791137570630035&amp;usg=AOvVaw2qh-OYLnHSGU4IddmsDx67">https://play.google.com/store/apps/details?id=com.app.postpadel</a></span></p><p class="c0"><span class="c20"><a class="c6" href="https://www.google.com/url?q=https://apps.apple.com/us/app/post-padel/id6762955796&amp;sa=D&amp;source=editors&amp;ust=1791137570630276&amp;usg=AOvVaw1BP6u9gglDjSz8L68lSYXM">https://apps.apple.com/us/app/post-padel/id6762955796</a></span></p><p class="c0 c4"><span class="c20 c7"></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 665.00px; height: 1440.00px;"><img alt="" src="data:image/png;base64," style="width: 665.00px; height: 1440.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c20 c7"></span></p><p class="c0 c4"><span class="c20 c7"></span></p><p class="c0 c4"><span class="c20 c7"></span></p><h2 class="c12" id="h.q5b3l4fgbekz"><span class="c5">Web Privacy AI &ndash; AI Data Removal App</span></h2><p class="c0"><span class="c1 c7">Category: AI Automation &amp; App Development<br>Industry: Data Privacy and Cybersecurity<br>Platforms: iOS and Android<br>Services: Mobile App Development, AI Automation and App-Store Deployment</span></p><h3 class="c14" id="h.iao34c7co05e"><span class="c9 c11">Portfolio Card Summary</span></h3><p class="c0"><span class="c1 c7">An AI-powered privacy application that finds personal information across data-broker websites and automates ongoing opt-out and removal requests.</span></p><h3 class="c14" id="h.wt9sxfar7z4t"><span class="c9 c11">App Overview</span></h3><p class="c0"><span class="c1 c7">Web Privacy AI helps individuals reduce unwanted exposure of their personal information across data-broker and people-search websites. It replaces a time-consuming manual removal process with an automated privacy-monitoring system.</span></p><h3 class="c14" id="h.9i4q46yefmul"><span class="c9 c11">Solution</span></h3><p class="c0"><span class="c1 c7">Web Privacy AI is an AI-driven data-removal application built for iOS and Android. The app scans more than 199 data-broker and people-search websites, identifies exposed personal information and automatically submits opt-out and removal requests.</span></p><p class="c0"><span class="c1 c7">Continuous monitoring and detailed privacy reports allow users to follow removal progress and identify when personal information reappears online.</span></p><h3 class="c14" id="h.hvj7ozh5kth8"><span class="c9 c11">App Links</span></h3><p class="c0"><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.app.flutter.web_privacy_ai&amp;sa=D&amp;source=editors&amp;ust=1791137570632937&amp;usg=AOvVaw3YIGxAr-C59_ERloVa7wQc">https://play.google.com/store/apps/details?id=com.app.flutter.web_privacy_ai</a></span></p><p class="c0"><span class="c18"><a class="c6" href="https://www.google.com/url?q=https://apps.apple.com/us/app/web-privacy-ai-data-removal/id6749375267&amp;sa=D&amp;source=editors&amp;ust=1791137570633204&amp;usg=AOvVaw2N09Wl9lMUI1DDAzrfaKdC">https://apps.apple.com/us/app/web-privacy-ai-data-removal/id6749375267</a></span></p><p class="c0 c4"><span class="c15"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><h2 class="c12" id="h.hwiw0lvwntf6"><span class="c5">Osity &ndash; AI Learning and Discovery App</span></h2><p class="c0"><span class="c1 c7">Category: AI Automation &amp; App Development<br>Industry: Education Technology<br>Platforms: iOS and Android<br>Services: Mobile App Development, AI-Assisted Discovery and App-Store Deployment</span></p><h3 class="c14" id="h.27n8my421oy"><span class="c9 c11">Portfolio Card Summary</span></h3><p class="c0"><span class="c1 c7">An intelligent learning and discovery app that helps curious minds explore meaningful ideas, investigate topics and organize knowledge without endless scrolling.</span></p><h3 class="c14" id="h.d3ff5n47ozbn"><span class="c9 c11">App Overview</span></h3><p class="c0"><span class="c1 c7">Osity is designed for lifelong learners and curious thinkers who want a calmer and more intentional way to discover information. It combines daily ideas, words, quotes and topics with tools for deeper exploration and knowledge organization.</span></p><h3 class="c14" id="h.8dt481cr84fp"><span class="c9 c11">Solution</span></h3><p class="c0"><span class="c1 c7">Osity is an AI-assisted learning and discovery application built for iOS and Android. Users can explore almost any subject, receive personalized discoveries, investigate topics more deeply and save valuable information inside a personal knowledge vault.</span></p><p class="c0"><span class="c1 c7">The app creates a focused alternative to passive content consumption by combining intelligent exploration, thoughtful curation and an organized library for revisiting saved ideas.</span></p><h3 class="c14" id="h.pz3l6sct1xce"><span class="c9 c11">App Links</span></h3><p class="c0"><span class="c20"><a class="c6" href="https://www.google.com/url?q=https://play.google.com/store/apps/details?id%3Dcom.app.osity&amp;sa=D&amp;source=editors&amp;ust=1791137570635734&amp;usg=AOvVaw2eCoTBWCCxx7pknHCbtnsC">https://play.google.com/store/apps/details?id=com.app.osity</a></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 810.00px; height: 1440.00px;"><img alt="" src="data:image/png;base64," style="width: 810.00px; height: 1440.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c23 c32"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c1 c7"></span></p><p class="c0 c4"><span class="c3"></span></p></body></html>